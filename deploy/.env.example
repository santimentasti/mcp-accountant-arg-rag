# Public domain pointing to this VM (Caddy gets a Let's Encrypt certificate automatically)
DOMAIN=mcp.tu-estudio.com.ar

# Auth: "static" (hashed bearer tokens in secrets/tokens.json) or "jwt" (your IdP)
CONTADOR_AUTH_MODE=static
# --- JWT mode (Auth0 / Supabase / WorkOS / Keycloak...) ---
# CONTADOR_AUTH_MODE=jwt
# CONTADOR_JWT_JWKS_URI=https://YOUR-IDP/.well-known/jwks.json
# CONTADOR_JWT_ISSUER=https://YOUR-IDP/
# CONTADOR_JWT_AUDIENCE=contador-mcp
# CONTADOR_TENANT_CLAIM=tenant

CONTADOR_RATE_LIMIT_RPS=5
CONTADOR_RATE_LIMIT_BURST=30
