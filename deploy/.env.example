# Public domain pointing to this VM (Caddy gets a Let's Encrypt certificate automatically)
DOMAIN=mcp.tu-estudio.com.ar

# ===== Recommended for sharing with accountants: OAuth ("Sign in with Google") =====
CONTADOR_AUTH_MODE=oauth
CONTADOR_OAUTH_PROVIDER=google
CONTADOR_PUBLIC_URL=https://mcp.tu-estudio.com.ar
CONTADOR_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
CONTADOR_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Who can get in (beta): invite (default) or open
CONTADOR_ACCESS_POLICY=invite
CONTADOR_ALLOWED_EMAILS=colega1@gmail.com,colega2@estudio.com.ar
# CONTADOR_ALLOWED_DOMAINS=miestudio.com.ar
CONTADOR_ADMIN_EMAILS=vos@gmail.com
CONTADOR_SUPPORT_CONTACT=vos@gmail.com
CONTADOR_OPERATOR_NAME=Contador IA (beta)
# Optional: stable secret (>=32 chars); if unset one is generated in /data/oauth-signing.key
# CONTADOR_OAUTH_SIGNING_KEY=

# ===== Alternatives =====
# Any OIDC IdP (Microsoft Entra, Auth0, Keycloak...):
# CONTADOR_OAUTH_PROVIDER=oidc
# CONTADOR_OIDC_CONFIG_URL=https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
# Static bearer tokens (API clients / Claude Code only):
# CONTADOR_AUTH_MODE=static   (+ deploy/secrets/tokens.json)
# JWT from your own IdP (no login flow, API clients):
# CONTADOR_AUTH_MODE=jwt  CONTADOR_JWT_JWKS_URI=...  CONTADOR_JWT_ISSUER=...  CONTADOR_JWT_AUDIENCE=contador-mcp

CONTADOR_RATE_LIMIT_RPS=5
CONTADOR_RATE_LIMIT_BURST=30
