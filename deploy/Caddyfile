{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# Limit request bodies (CSV/document uploads are capped in-app too).
	request_body {
		max_size 8MB
	}
	reverse_proxy contador:8000
	log {
		output stdout
		format json
	}
}
